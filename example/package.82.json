{
  "name": "react-native-toast-message-harmony-example",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "reStart": "npm run install:pkg && hdc rport tcp:8081 tcp:8081 && react-native start",
    "start": "hdc rport tcp:8081 tcp:8081 && react-native start",
    "pack:pkg": "cd ../ && npm run build && npm pack && cd ./example",
    "install:pkg": "npm uninstall @react-native-ohos/react-native-toast-message && npm run pack:pkg && npm i @react-native-ohos/react-native-toast-message@file:../react-native-ohos-react-native-toast-message-2.5.3-beta.1.tgz",
    "dev": "react-native bundle-harmony --dev --minify=false",
    "prod": "react-native bundle-harmony --dev=false --minify=true",
    "postinstall": "node ./scripts/create-build-profile",
    "fast:pkg": "cd ../ && npm i --legacy-peer-deps && npm run build && npm pack && cd ./example && npm i && npm run dev"
  },
  "dependencies": {
    "@rnoh/testerino": "npm:@react-native-oh-tpl/testerino@0.0.9",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-harmony": "npm:@react-native-oh/react-native-harmony@0.82.33",
    "@react-native-ohos/react-native-toast-message": "file:../react-native-ohos-react-native-toast-message-2.5.3-beta.1.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native-oh/react-native-harmony-cli": "0.82.33",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/react": "^19.1.0",
    "json5": "^2.2.3",
    "typescript": "5.5.4"
  },
  "overrides": {
    "@react-native-community/cli": "20.0.0"
  },
  "resolutions": {
    "@react-native-community/cli": "20.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
