{
  "name": "react-native-toast-message-harmony-example",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "i": "cd ../ && npm i && npm run build && npm pack && cd ./example && npm i",
    "reStart": "npm run install:pkg && hdc rport tcp:8081 tcp:8081 && react-native start",
    "start": "hdc rport tcp:8081 tcp:8081 && react-native start",
    "pack:pkg": "cd ../ && npm pack && cd ./example",
    "install:pkg": "npm uninstall react-native-toast-message && npm run pack:pkg && npm i react-native-toast-message@file:../@react-native-ohos-eact-native-toast-message-2.5.3-beta.1.tgz",
    "dev": "react-native bundle-harmony --dev --minify=false",
    "prod": "react-native bundle-harmony --dev=false --minify=true",
    "postinstall": "node ./scripts/create-build-profile"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-native": "0.77.1",
    "react-native-harmony": "npm:@react-native-oh/react-native-harmony@^0.77.10",
    "react-native-toast-message": "file:../@react-native-ohos-react-native-toast-message-2.5.3-beta.1.tgz"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native-oh/react-native-harmony-cli": "^0.0.27",
    "@react-native/babel-preset": "0.77.1",
    "@react-native/metro-config": "^0.77.1",
    "@react-native/typescript-config": "0.77.1",
    "@types/react": "^18.2.6",
    "json5": "^2.2.3",
    "typescript": "5.5.4"
  },
  "overrides": {
    "@react-native-community/cli": "15.0.1",
    "metro": "^0.81.0"
  },
  "resolutions": {
    "@react-native-community/cli": "15.0.1",
    "metro": "^0.81.0"
  },
  "engines": {
    "node": ">=18"
  }
}
